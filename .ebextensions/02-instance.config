commands:
  01_swap:
    command: |
      if [ ! -f /swapfile ]; then
        dd if=/dev/zero of=/swapfile bs=1M count=2048
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo '/swapfile none swap sw 0 0' >> /etc/fstab
      fi
    ignoreErrors: true

  02_fonts:
    command: |
      dnf install -y fontconfig dejavu-sans-fonts || yum install -y fontconfig dejavu-sans-fonts || true
    ignoreErrors: true

  03_upload_dir:
    command: |
      mkdir -p /var/app/data/uploads
      chmod 0777 /var/app/data/uploads
    ignoreErrors: true
