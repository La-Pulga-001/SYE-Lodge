option_settings:
  aws:ec2:instances:
    InstanceTypes: t3.micro

  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/universities

  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/universities
    HealthCheckInterval: 30
    HealthyThresholdCount: 2

  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    PORT: "5000"
    UPLOAD_DIR: /var/app/data/uploads
    LOG_FILE: /tmp/sye_lodge.log
    JAVA_TOOL_OPTIONS: "-Xms128m -Xmx320m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -Xss512k -Djava.awt.headless=true"
    DEMO_DATA: "true"
    DEMO_PASSWORD: Demo@1234
    MAIL_MODE: console
    APP_URL: http://sye-lodge-prod.elasticbeanstalk.com

  aws:elasticbeanstalk:command:
    Timeout: "1800"

  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: "true"
    RetentionInDays: "7"

  aws:rds:dbinstance:
    DBDeletionPolicy: Snapshot
